# Docker deployment (Compose >= 2.24)
BID_BIND_HOST=127.0.0.1
BID_HTTP_PORT=8080
BID_IMAGE_TARGET=runtime
BID_IMAGE_TAG=local
# runtime: local PDF/DOCX + remote MinerU/LLM; full: local OCR/Docling/RAG
PYTHON_IMAGE=m.daocloud.io/docker.io/library/python:3.12-slim
NGINX_IMAGE=m.daocloud.io/docker.io/library/nginx@sha256:4a73073bd557c65b759505da037898b61f1be6cbcc3c2c3aeac22d2a470c1752
REDIS_IMAGE=m.daocloud.io/docker.io/library/redis:7-alpine
BID_STORAGE_DIR=storage
BID_MAX_UPLOAD_MB=50
BID_CORS_ORIGINS=
BID_ALLOW_SERVER_PATHS=false
BID_REDIS_URL=redis://redis:6379/0
# Enable accounts for team access. First start creates this administrator once.
BID_AUTH_ENABLED=false
BID_ADMIN_USERNAME=
BID_ADMIN_PASSWORD=
# Set true when the browser uses HTTPS.
BID_COOKIE_SECURE=false

# LLM provider config
LLM_MODEL_DISPLAY_NAME=
LLM_MODEL_ID=
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT=180
LLM_MAX_CONCURRENCY=2
LLM_STREAM_MAX_CONCURRENCY=4
BID_FAST_MARKDOWN_EXTRACTION=true
BID_STRUCTURED_OUTPUT_ENABLED=false

# Optional vector store / RAG index
BID_VECTOR_STORE_ENABLED=false
HF_ENDPOINT=https://hf-mirror.com
CHROMA_PERSIST_DIR=storage/chroma
CHROMA_COLLECTION=bid_document_chunks
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL_ID=BAAI/bge-large-zh-v1.5
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_BATCH_SIZE=32
RERANKER_ENABLED=false
RERANKER_MODEL_ID=BAAI/bge-reranker-v2-m3
RERANKER_TOP_K_MULTIPLIER=4

# Lightweight prefilter for qualification/rejection full coverage
BID_QUAL_PREFILTER_ENABLED=true
BID_QUAL_PREFILTER_RULE_RECALL_ENABLED=true
BID_QUAL_PREFILTER_RULE_MAX_CHARS=30000
BID_QUAL_PREFILTER_RULE_CONTEXT_CHARS=3600
BID_QUAL_PREFILTER_MODEL_ID=Qwen/Qwen3-8B
BID_QUAL_PREFILTER_TIMEOUT=120
BID_QUAL_PREFILTER_MAX_CHUNKS=24
BID_QUAL_PREFILTER_CHUNK_CHARS=3600
BID_QUAL_PREFILTER_BATCH_SIZE=6
BID_QUAL_PREFILTER_CONCURRENCY=2
BID_QUAL_PREFILTER_CONFIDENCE=0.45
BID_QUAL_PREFILTER_MERGE_MAX=20

# MinerU document parsing API
MINERU_API_TOKEN=
MINERU_REQUEST_TIMEOUT=60
MINERU_PARALLEL_PAGE_CHUNK_SIZE=30
MINERU_PARALLEL_MAX_WORKERS=3

# Optional web search API
SERPAPI_API_KEY=
